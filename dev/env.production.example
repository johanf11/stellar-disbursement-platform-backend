# Copy this to /opt/sdp/.env on the droplet and fill in every value.

# Database (Supabase)
DATABASE_URL=postgres://postgres:sT7LpgmsT2TNo4d0@db.pwbjulfhqryrinkwijrx.supabase.co:5432/postgres?sslmode=require

# Stellar Network
NETWORK_TYPE=testnet
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
HORIZON_URL=https://horizon-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org
RPC_REQUEST_AUTH_HEADER_KEY=
RPC_REQUEST_AUTH_HEADER_VALUE=

# API
PORT=8000
METRICS_PORT=8002
ADMIN_PORT=8003
BASE_URL=http://64.225.19.99:8000
SDP_UI_BASE_URL=http://64.225.19.99:3000
ENVIRONMENT=production
LOG_LEVEL=INFO
METRICS_TYPE=PROMETHEUS
CORS_ALLOWED_ORIGINS=*

# Auth & Security
DISABLE_MFA=false
DISABLE_RECAPTCHA=true
SEP10_CLIENT_ATTRIBUTION_REQUIRED=true
# Generate with: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
EC256_PRIVATE_KEY=

# SEP-10 Signing
SEP10_SIGNING_PUBLIC_KEY=
SEP10_SIGNING_PRIVATE_KEY=

# SEP-24
SEP24_JWT_SECRET=

# SEP-45
ENABLE_SEP45=true
SEP45_CONTRACT_ID=CDY4CS2VWHAZOMYVTKUFKGNZKIVFBCXUFNFQ5KSXOTAHKL5H5ZRTAUTH

# Embedded Wallets
ENABLE_EMBEDDED_WALLETS=true
EMBEDDED_WALLETS_WASM_HASH=9b784817dff1620a3e2b223fe1eb8dac56e18980dea9726f692847ccbbd3a853

# Distribution Account
DISTRIBUTION_PUBLIC_KEY=
DISTRIBUTION_SEED=
DISTRIBUTION_ACCOUNT_ENCRYPTION_PASSPHRASE=
CHANNEL_ACCOUNT_ENCRYPTION_PASSPHRASE=

# Multi-tenant
INSTANCE_NAME=SDP Production
SINGLE_TENANT_MODE=true
ADMIN_ACCOUNT=SDP-admin
ADMIN_API_KEY=
TENANT_XLM_BOOTSTRAP_AMOUNT=5

# Default tenant
DEFAULT_TENANT_OWNER_EMAIL=
DEFAULT_TENANT_OWNER_FIRST_NAME=
DEFAULT_TENANT_OWNER_LAST_NAME=
DEFAULT_TENANT_DISTRIBUTION_ACCOUNT_TYPE=DISTRIBUTION_ACCOUNT.STELLAR.ENV

# Scheduler
SCHEDULER_RECEIVER_INVITATION_JOB_SECONDS=10
SCHEDULER_PAYMENT_JOB_SECONDS=10

# TSS
NUM_CHANNEL_ACCOUNTS=3
MAX_BASE_FEE=1000000
TSS_METRICS_PORT=9002
TSS_METRICS_TYPE=TSS_PROMETHEUS

# Messaging (leave as DRY_RUN unless configured)
EMAIL_SENDER_TYPE=DRY_RUN
SMS_SENDER_TYPE=DRY_RUN
AWS_ACCESS_KEY_ID=
AWS_REGION=
AWS_SECRET_ACCESS_KEY=
AWS_SES_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=
TWILIO_SENDGRID_API_KEY=
TWILIO_SENDGRID_SENDER_ADDRESS=
TWILIO_WHATSAPP_FROM_NUMBER=
TWILIO_WHATSAPP_RECEIVER_INVITATION_TEMPLATE_SID=
TWILIO_WHATSAPP_USER_FORGOT_PASSWORD_TEMPLATE_SID=
TWILIO_WHATSAPP_USER_INVITATION_TEMPLATE_SID=
TWILIO_WHATSAPP_RECEIVER_OTP_TEMPLATE_SID=
